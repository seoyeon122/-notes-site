---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Rail from '../components/Rail.astro';

type Props = CollectionEntry<'issues'>['data'];

const { title, issue, pubDate, author, originalUrl, summary, heroImage, highlights = [], headings = [] } =
	Astro.props;
const pageTitle = issue ? `第 ${issue} 期 · ${title}` : title;
const tocItems = headings.filter((h) => h.depth === 2);
---

<html lang="zh-CN" data-theme="light">
	<head>
		<BaseHead title={pageTitle} description={summary || title} />
		<style>
			.issue-head {
				text-align: center;
				padding: 1.5em 0 2em;
			}
			.issue-no {
				display: inline-block;
				color: var(--accent);
				border: 1px solid var(--accent);
				border-radius: 999px;
				padding: 0.2em 1em;
				font-size: 0.85em;
				letter-spacing: 0.15em;
				margin-bottom: 1em;
			}
			.issue-head h1 {
				font-family: var(--font-serif);
				font-size: 2em;
				margin: 0 0 0.6em;
			}
			.meta {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.hl-compact {
				margin: 0 auto 2.5em;
				max-width: 720px;
				border: 1px solid rgb(var(--gray-light));
				border-left: 4px solid var(--accent);
				border-radius: 8px;
				padding: 1.2em 1.5em;
				background: rgb(var(--gray-light), 30%);
			}
			.hl-compact-label {
				font-size: 0.8em;
				letter-spacing: 0.15em;
				color: rgb(var(--gray));
				margin: 0 0 0.8em;
			}
			.hl-compact-item {
				margin-bottom: 0.8em;
			}
			.hl-compact-item:last-child {
				margin-bottom: 0;
			}
			.hl-compact-title {
				font-weight: 700;
				color: var(--ink);
			}
			.hl-compact-points {
				margin: 0.2em 0 0;
				padding-left: 1.2em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			/* 时间线目录（Timeline Scrollspy）：右侧灰色小线段，滚动高亮当前章节 */
			.toc-tl {
				position: fixed;
				right: 28px;
				top: 50%;
				transform: translateY(-50%);
				z-index: 40;
				display: none; /* 窄屏隐藏 */
			}
			@media (min-width: 1200px) {
				.toc-tl {
					display: block;
				}
			}
			.toc-tl ol {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				gap: 10px;
			}
			.toc-tl-item a {
				display: flex;
				align-items: center;
				gap: 10px;
				text-decoration: none;
				color: inherit;
			}
			.toc-tl-seg {
				display: block;
				width: 4px;
				height: 14px;
				border-radius: 999px;
				background: #c9c4bc; /* 灰 */
				transition:
					width 0.25s ease,
					height 0.25s ease,
					background-color 0.25s ease;
			}
			.toc-tl-label {
				order: -1; /* 标签在左、线段在右 */
				font-size: 0.85em;
				color: #6b7180;
				white-space: nowrap;
				opacity: 0;
				transform: translateX(8px);
				transition:
					opacity 0.2s ease,
					transform 0.2s ease;
			}
			.toc-tl-item.active .toc-tl-seg {
				width: 6px;
				height: 20px;
				background: #e0dcd3; /* 更浅的灰（高亮） */
			}
			.toc-tl-item.active .toc-tl-label {
				font-size: 1.1em;
				font-weight: 700;
				color: #242833;
			}
			/* 悬停：显示全部章节名 */
			.toc-tl:hover .toc-tl-label {
				opacity: 1;
				transform: translateX(0);
			}
			.toc-tl-item a:hover .toc-tl-label {
				color: #c8102e;
			}
			.article-foot {
				margin-top: 3em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
				display: flex;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 0.8em;
				font-size: 0.92em;
			}
		</style>
	</head>
	<body>
		<Rail />
		<div id="progress-bar"></div>
		<main>
			<article>
				<header class="issue-head">
					{issue && <p class="issue-no">第 {issue} 期</p>}
					<h1 data-animate>{title}</h1>
					<p class="meta">
						<FormattedDate date={pubDate} />
						{author && ` · ${author}`}
					</p>
				</header>
				{
					highlights.length > 0 && (
						<div class="hl-compact">
							<p class="hl-compact-label">本周速览</p>
							{
								highlights.map((h) => (
									<div class="hl-compact-item">
										<span class="hl-compact-title">{h.title}</span>
										{h.points.length > 0 && (
											<ul class="hl-compact-points">
												{h.points.map((p) => (
													<li>{p}</li>
												))}
											</ul>
										)}
									</div>
								))
							}
						</div>
					)
				}
				{heroImage && <Image width={1280} height={720} src={heroImage} alt="" />}
				<div class="prose">
					<slot />
				</div>
				<footer class="article-foot">
					{originalUrl && (
						<a href={originalUrl} target="_blank" rel="noopener noreferrer">
							本文首发于 B 站专栏 ↗
						</a>
					)}
					<a href="/archive">← 全部期数</a>
				</footer>
			</article>
		</main>
		<Footer />
		{
			tocItems.length > 0 && (
				<nav class="toc-tl" aria-label="文章目录">
					<ol>
						{
							tocItems.map((h) => (
								<li class="toc-tl-item">
									<a href={`#${h.slug}`}>
										<span class="toc-tl-label">{h.text}</span>
										<span class="toc-tl-seg"></span>
									</a>
								</li>
							))
						}
					</ol>
				</nav>
			)
		}
		<script>
			const bar = document.getElementById('progress-bar');
			function update() {
				const doc = document.documentElement;
				const max = doc.scrollHeight - doc.clientHeight;
				bar.style.width = max > 0 ? (doc.scrollTop / max) * 100 + '%' : '0%';
			}
			addEventListener('scroll', update, { passive: true });
			addEventListener('astro:page-load', update);
			update();

			// 阅读页固定浅色（与首页/全局主题解耦，不随明暗切换变化）
			document.documentElement.setAttribute('data-theme', 'light');
			document.addEventListener('astro:page-load', () => {
				document.documentElement.setAttribute('data-theme', 'light');
			});

			// 从首页高亮卡进入：滚动到对应小节
			const hash = decodeURIComponent(window.location.hash.slice(1));
			if (hash) {
				setTimeout(() => {
					const h = [...document.querySelectorAll('.prose h2')].find((el) => el.textContent.includes(hash));
					if (h) h.scrollIntoView({ behavior: 'smooth', block: 'start' });
				}, 60);
			}

			// 目录点击：平滑滚动到对应小节
			document.querySelectorAll('.toc-tl-item a').forEach((a) => {
				a.addEventListener('click', (e) => {
					e.preventDefault();
					const target = document.querySelector(a.getAttribute('href') || '');
					if (target) {
						target.scrollIntoView({ behavior: 'smooth', block: 'start' });
						history.replaceState(null, '', a.getAttribute('href'));
					}
				});
			});

			// 时间线目录滚动监听（Scrollspy）：高亮当前章节
			const tlSections = [...document.querySelectorAll('.prose h2')];
			const tlItems = [...document.querySelectorAll('.toc-tl-item')];
			function updateTlSpy() {
				if (!tlItems.length) return;
				const marker = window.scrollY + window.innerHeight * 0.35;
				let active = 0;
				tlSections.forEach((s, i) => {
					if (s.getBoundingClientRect().top + window.scrollY <= marker) active = i;
				});
				if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
					active = tlItems.length - 1;
				}
				tlItems.forEach((it, i) => it.classList.toggle('active', i === active));
			}
			addEventListener('scroll', () => requestAnimationFrame(updateTlSpy), { passive: true });
			addEventListener('astro:page-load', updateTlSpy);
			updateTlSpy();
		</script>
	</body>
</html>
