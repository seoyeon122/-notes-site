---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Rail from '../components/Rail.astro';
import RadioArchive from '../components/RadioArchive.astro';
import { SITE_TITLE } from '../consts';
import archiveBg from '../assets/archivedRadioBackground.png';
import { Image } from 'astro:assets';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`早间电台 | ${SITE_TITLE}`} description="四时小路的早间电台 · 每周一清晨的音乐分享" />
		<style>
			/* 归档页背景图：原色铺满，不加遮罩（先看无遮罩效果） */
			body {
				position: relative;
				isolation: isolate;
				background: #282b35;
			}
			.archive-bg {
				position: fixed;
				inset: 0;
				z-index: -1;
				width: 100%;
				height: 100%;
				object-fit: cover;
				pointer-events: none;
			}
			main.radio-main {
				max-width: none;
				margin: 0;
				padding: 3em 2em 4em;
			}
			.radio-page-head {
				max-width: 1400px;
				margin: 0 0 50px; /* 分割线距专辑区 50px */
				text-align: left;
			}
			.radio-page-head .kicker {
				display: block;
				font-size: 0.78em;
				letter-spacing: 0.26em;
				color: rgb(var(--gray));
				margin-bottom: 0.6em;
			}
			.radio-page-head h1 {
				font-family: var(--font-serif);
				font-weight: 400;
				font-size: 1.9em;
				margin: 0 0 50px; /* 标题距分割线 50px */
			}
			/* 阳光米色分割线：分隔标题区与专辑区 */
			.radio-rule {
				height: 1px;
				background: linear-gradient(90deg, #f3d6a1 0%, rgba(243, 214, 161, 0.35) 45%, rgba(243, 214, 161, 0) 100%);
			}
			/* RadioArchive 全宽展示（内部网格 auto-fill 自动排满） */
			.radio-archive {
				width: 100%;
			}
			@media (max-width: 820px) {
				main.radio-main {
					padding: 1.6em 1em 3em;
				}
			}
		</style>
	</head>
	<body>
		<Image
			class="archive-bg"
			src={archiveBg}
			format="webp"
			widths={[640, 960, 1280, 1672]}
			sizes="100vw"
			quality="high"
			loading="eager"
			fetchpriority="high"
			decoding="async"
			alt=""
			aria-hidden="true"
		/>
		<Rail />
		<main class="radio-main">
			<div class="radio-archive">
				<header class="radio-page-head">
					<span class="kicker">MORNING RADIO · 每周一清晨</span>
					<h1>四时小路的早间电台</h1>
					<div class="radio-rule" aria-hidden="true"></div>
				</header>
				<RadioArchive />
			</div>
		</main>
		<Footer />
	</body>
</html>
