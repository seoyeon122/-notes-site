---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Rail from '../components/Rail.astro';
import { SITE_TITLE, RADIO_EPISODES } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`早间电台 | ${SITE_TITLE}`} description="四时小路的早间电台 · 每周一清晨的音乐分享" />
		<style>
			main.radio-main {
				max-width: none;
				margin: 0;
				padding: 3em 2em 4em;
			}
			.radio-page-head {
				margin-bottom: 2.5em;
			}
			.radio-page-head .kicker {
				display: block;
				font-size: 0.78em;
				letter-spacing: 0.26em;
				color: rgb(var(--gray));
				margin-bottom: 0.6em;
			}
			.radio-page-head h1 {
				font-family: var(--font-serif);
				font-weight: 400;
				font-size: 1.9em;
				margin: 0;
			}
			/* 番剧索引式网格：桌面端排满，列宽固定，封面保持 1:1 正方形 */
			.radio-index {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 240px));
				justify-content: center; /* 行不满时居中，不拉伸 */
				gap: 1.6em;
			}
			.radio-item {
				display: block;
				text-decoration: none;
				color: var(--ink);
			}
			.radio-item .cover {
				position: relative;
				aspect-ratio: 1 / 1;
				overflow: hidden;
				border-radius: 2px;
				border: 1px solid rgb(var(--gray-light));
			}
			.radio-item .cover img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				filter: saturate(0.95);
				transition: transform 0.3s ease;
			}
			.radio-item:hover .cover img {
				transform: scale(1.03); /* 轻微放大，替代悬浮抬升 */
			}
			.radio-item .meta {
				margin-top: 0.6em;
			}
			.radio-item .no {
				display: block;
				font-size: 0.76em;
				letter-spacing: 0.14em;
				color: var(--accent);
				margin-bottom: 0.15em;
			}
			.radio-item .album {
				display: block;
				font-family: var(--font-serif);
				font-size: 0.95em;
				line-height: 1.4;
				color: var(--ink);
			}

			/* 手机：一行两个，和首页电台版一致 */
			@media (max-width: 820px) {
				main.radio-main {
					padding: 1.6em 1em 3em;
				}
				.radio-index {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 1em;
				}
			}
		</style>
	</head>
	<body>
		<Rail />
		<main class="radio-main">
			<header class="radio-page-head">
				<span class="kicker">MORNING RADIO · 每周一清晨</span>
				<h1>四时小路的早间电台</h1>
			</header>
			<div class="radio-index">
				{
					RADIO_EPISODES.map((ep) => (
						<a class="radio-item" href={ep.url} target="_blank" rel="noopener noreferrer">
							<span class="cover">
								<img src={ep.image} alt={`第 ${ep.issue} 期 · ${ep.album}`} loading="lazy" />
							</span>
							<span class="meta">
								<span class="no">第 {ep.issue} 期</span>
								<span class="album">{ep.album}</span>
							</span>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
