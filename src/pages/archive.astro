---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';

const issues = (await getCollection('issues')).sort((a, b) => b.data.issue - a.data.issue);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`归档 | ${SITE_TITLE}`} description="全部期数" />
		<style>
			h1 {
				font-family: var(--font-serif);
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.row {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 1em 0.4em;
				color: var(--ink);
				text-decoration: none;
			}
			.row:hover .title {
				color: var(--red);
			}
			.no {
				color: var(--red);
				font-weight: 700;
				min-width: 5em;
			}
			.title {
				flex: 1;
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			@media (max-width: 480px) {
				.no {
					min-width: 4em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>观测归档</h1>
			<ul>
				{
					issues.map((issue) => (
						<li>
							<a class="row" href={`/issue/${issue.id}/`}>
								<span class="no">第 {issue.data.issue} 期</span>
								<span class="title">{issue.data.title}</span>
								<span class="date">
									<FormattedDate date={issue.data.pubDate} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
