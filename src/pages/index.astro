---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Rail from '../components/Rail.astro';
import FourAMWatch from '../components/FourAMWatch.astro';
import RadioAlbums from '../components/RadioAlbums.astro';
import VideoCinema from '../components/VideoCinema.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { SITE_DESCRIPTION, SITE_TITLE, RADIO_LATEST_URL } from '../consts';
import bg from '../assets/Background_test01.png';
import radioBg from '../assets/Radiobackground.png';

const issues = (await getCollection('issues')).sort((a, b) => b.data.issue - a.data.issue);
const latest = issues[0];
const second = issues[1];
const rest = issues.slice(1);
// 首页右区：每行一期的高亮卡（每期最多取前 2 条）
const rows = [latest, second]
	.filter(Boolean)
	.map((issue) => ({ issue, cards: issue.data.highlights.slice(0, 2) }))
	.filter((r) => r.cards.length > 0);
// 标签语在"："后换行（只影响首页展示）
const descParts = SITE_DESCRIPTION.split('：');
// ★ 首页"近期更新"栏：每次周报/电台/投稿有更新时，在最前面加一条
//   { date: 'YYYY-MM-DD', title: '标题', href: '跳转目标' }
//   - 周报更新 → href 用 `/issue/issue-N/`
//   - 电台更新 → href 用 `#radio`（跳转到早间电台版）
//   - 投稿更新 → href 用 `#videos`（跳转到首页投稿影院版）
const recentUpdates = [
	{ date: '2026-09-07', title: '四时小路早间电台第五期 · 观众推歌电台第一期', href: '#radio' },
	{ date: '2026-09-07', title: '新投稿 · 大女優さん（想要上演一出疯狂的独角戏）', href: '#videos' },
	{ date: '2026-09-07', title: '第五期 · 病弱形态与整活不断', href: '/issue/issue-5/' },
	{ date: '2026-09-01', title: '第四期 · 都市传说身体抱恙', href: '/issue/issue-4/' },
	{ date: '2026-08-31', title: '四时小路早间电台第四期', href: '#radio' },
];
// ★ 早间电台"收听最新一期"按钮的链接 = 最新一期（数据在 consts.ts 的 RADIO_EPISODES）
const radioLatestUrl = RADIO_LATEST_URL;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main.home-main {
				max-width: none;
				margin: 0;
				padding: 0;
			}

			/* ===== 上半：报告左右两页（暗红黑） ===== */
			.poster {
				position: relative;
				overflow: hidden;
				min-height: 100svh;
				min-height: 100vh;
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				background-color: #0c0505;
				color: #f6ebe8;
			}
			.poster-bg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				opacity: 0.9;
				pointer-events: none;
			}
			.poster-left,
			.report-panel {
				position: relative;
				z-index: 1;
			}

			/* 左页：封面信息（左上，左对齐，左侧留约 50px） */
			.poster-left {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				justify-content: flex-start;
				text-align: left;
				padding: 4.5rem 1.5rem 2.5rem 1.5rem;
			}
			.poster .signals {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				margin-bottom: 1.8em;
				/* 去底框：纯三灯，更克制（传单质感） */
				background: none;
				border: none;
				padding: 0;
			}
			.poster .signals span {
				width: 9px;
				height: 9px;
				border-radius: 50%;
			}
			.poster .signals .r {
				background: #ff2231;
			}
			.poster .signals .y {
				background: #ffd100;
			}
			.poster .signals .g {
				background: #00a651;
			}
			.poster-kicker {
				font-family: var(--font-num);
				font-size: 0.72em;
				letter-spacing: 0.28em;
				color: #8b8580;
				margin: 0 0 1.2em;
				text-transform: uppercase;
			}
			.poster-title {
				font-family: var(--font-serif);
				font-size: clamp(2rem, 4.5vw, 3.4rem);
				line-height: 1.25;
				font-weight: 400;
				margin: 0 0 0.6em;
				color: #f6ebe8;
				letter-spacing: 0.05em;
			}
			.poster-tagline {
				color: #b9b1ac;
				max-width: 30em;
				margin: 0 0 1em;
			}
			.poster-cta {
				display: inline-block;
				margin-top: 2em;
				padding: 0.6em 1.6em;
				border: 1px solid var(--red);
				border-radius: 2px; /* 胶囊 → 直角细框 */
				color: var(--ink);
				font-size: 0.92em;
				letter-spacing: 0.06em;
				text-decoration: none;
				transition:
					background-color var(--dur-fast) ease,
					color var(--dur-fast) ease;
			}
			.poster-cta:hover {
				background: var(--red);
				color: #fff;
				text-decoration: none;
			}
			.scroll-hint {
				align-self: center;
				margin-top: auto;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 2.8em;
				height: 2.8em;
				border-radius: 2px; /* 收圆角 */
				color: #b06a78;
				background: rgba(255, 34, 49, 0.06);
				border: 1px solid rgba(255, 34, 49, 0.2);
				animation: hint-breathe 2.6s ease-in-out infinite;
				text-decoration: none;
			}
			.scroll-hint:hover {
				color: #ff2231;
			}
			@keyframes hint-breathe {
				0%,
				100% {
					transform: translateY(0);
					opacity: 0.9;
				}
				50% {
					transform: translateY(7px);
					opacity: 0.55;
				}
			}

			/* 右区：两期高亮卡（无预览窗，白卡直接浮在暗底上） */
			.report-panel {
				display: flex;
				justify-content: flex-start;
				align-items: flex-start;
				padding: 2rem 2.5rem 0 0.5rem;
			}
			.hl-grid {
				display: flex;
				width: 100%;
				min-width: 0;
				flex-direction: column;
				gap: 34px;
			}
			.hl-row {
				display: flex;
				flex-direction: column;
				gap: 10px;
			}
			.hl-row-label {
				color: #b9b1ac;
				font-size: 0.85em;
				letter-spacing: 0.04em;
				text-decoration: none;
			}
			.hl-row-label:hover {
				color: #ff2231;
				text-decoration: none;
			}
			.hl-row-cards {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 30px;
			}
			.hl-card {
				display: flex;
				flex-direction: column;
				aspect-ratio: 4 / 3;
				background: #fff;
				border: 1px solid #e3ded5;
				border-radius: 3px; /* 收圆角 */
				overflow: hidden;
				text-decoration: none;
				color: #242833;
				transition: border-color 0.25s ease;
			}
			.hl-card:hover {
				border-color: #c8102e; /* 去悬浮抬升，只变边框 */
				text-decoration: none;
			}
			.hl-card-img {
				width: 100%;
				flex: 17;
				object-fit: cover;
				min-height: 0;
				display: block;
			}
			.hl-card-body {
				flex: 7; /* 文字区由约 1/4 增至约 7/24 */
				padding: 0.5em 1em 0.7em;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.15em;
				overflow: hidden;
			}
			.hl-card-body h4 {
				margin: 0;
				font-family: var(--font-serif);
				font-size: 0.95em;
				line-height: 1.25;
				color: #242833;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.hl-card-body ul {
				margin: 0;
				padding-left: 1.1em;
				color: #6b7180;
				font-size: 0.76em;
			}
			.hl-card-enter {
				margin-top: auto;
				color: #c8102e;
				font-size: 0.8em;
				font-weight: 600;
			}

			/* ===== 下半：往期观测（yorushika 式暖白信息区） ===== */
			.info {
				min-height: 120svh; /* 第二版加高 1.2 倍：滚动时有余地看完整背景 */
				min-height: 120vh;
				padding: 5em 1.5em 4em;
				background: #f6f4f0;
				color: #242833;
				display: flex;
				flex-direction: column;
				align-items: center;
			}
			.info-inner {
				width: 720px;
				max-width: 100%;
			}
			.info h2 {
				font-family: var(--font-serif);
				font-size: 1.8em;
				text-align: center;
				margin-bottom: 1.5em;
				color: #242833;
				border: none;
			}
			.issue-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.issue-list li {
				border-bottom: 1px solid #e3ded5;
			}
			.issue-list .row {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 1em 0.4em;
				color: #242833;
				text-decoration: none;
			}
			.issue-list .row:hover .title {
				color: #c8102e;
			}
			.issue-list .no {
				color: #c8102e;
				font-weight: 700;
				min-width: 5em;
				font-size: 0.95em;
			}
			.issue-list .title {
				flex: 1;
			}
			.issue-list .date {
				color: #8b8680;
				font-size: 0.85em;
			}
			.archive-link {
				display: block;
				text-align: center;
				margin-top: 2em;
				font-size: 0.95em;
				color: #c8102e;
				text-decoration: none;
			}

			/* 第一版左栏"近期更新"小栏：仿往期观测列表格式，暗色封面配色 */
			.recent {
				margin-top: 2.4em;
				width: 100%;
				max-width: 30em;
			}
			.recent-title {
				font-family: var(--font-serif);
				font-size: 1em;
				color: #b9b1ac;
				letter-spacing: 0.08em;
				margin: 0 0 0.7em;
				border: none;
			}
			.recent-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.recent-list li {
				border-bottom: 1px solid rgba(246, 235, 232, 0.12);
			}
			.recent-list .row {
				display: flex;
				align-items: baseline;
				gap: 0.9em;
				padding: 0.85em 0.2em;
				color: #f6ebe8;
				text-decoration: none;
			}
			.recent-list .row:hover .title {
				color: #ff2231;
			}
			.recent-list .date {
				color: #ff2231;
				font-weight: 600;
				font-size: 0.88em;
				min-width: 7.5em;
			}
			.recent-list .title {
				flex: 1;
				font-size: 0.95em;
			}

			/* ===== 第一点五版（早间电台）：背景图原色 + 左介绍 + 右四图 ===== */
			.radio {
				position: relative;
				overflow: hidden;
				min-height: 120svh; /* 加高 1.2 倍：滚动到第二版时有余地，减少上一版残留 */
				min-height: 120vh;
				scroll-margin-top: -80px; /* 锚点跳转（近期更新）时多往下滚 80px（负值=越过视口顶部 80px） */
				display: grid;
				grid-template-columns: minmax(0, calc(50% + 160px)) minmax(0, calc(50% - 160px));
				background: #282b35;
				color: #f6ebe8;
			}
			.radio-bg {
				position: absolute;
				inset: 0;
				z-index: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				pointer-events: none;
			}
			.radio-left,
			.radio-panel {
				position: relative;
				z-index: 2;
			}
			.radio-left {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				justify-content: center;
				text-align: left;
				text-shadow: 0 2px 14px rgba(20, 12, 16, 0.5);
				padding: 4.5rem 1.5rem;
			}
			.radio-kicker {
				font-size: 0.85em;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: #e2b978;
				margin-bottom: 1.2em;
			}
			.radio-title {
				font-family: var(--font-serif);
				font-size: clamp(2rem, 4.5vw, 3.2rem);
				line-height: 1.25;
				margin: 0 0 0.6em;
				color: #f3d6a1;
				letter-spacing: 0.04em;
			}
			.radio-desc {
				max-width: 30em;
				color: #efd8b2;
				margin: 0 0 1.6em;
				line-height: 1.9;
			}
			.radio-cta {
				display: inline-block;
				padding: 0.6em 1.6em;
				border: 1px solid rgba(243, 214, 161, 0.72);
				border-radius: 2px; /* 胶囊 → 直角细框 */
				color: #f3d6a1;
				text-decoration: none;
				font-size: 0.92em;
				letter-spacing: 0.06em;
				transition:
					background-color var(--dur-fast) ease,
					color var(--dur-fast) ease;
			}
			.radio-cta:hover {
				background: #f3d6a1;
				color: #2b2024;
				text-decoration: none;
			}
			.radio-panel {
				display: flex;
				align-items: center;
				padding: 2.5rem;
			}
			.radio-archive-link {
				position: absolute;
				right: 2.5rem;
				bottom: 2.5rem;
				z-index: 3;
				display: inline-flex;
				align-items: center;
				min-height: 42px;
				box-sizing: border-box;
				padding: 0.6em 1.6em;
				border: 1px solid rgba(243, 214, 161, 0.72);
				border-radius: 2px; /* 与「收听最新一期」一致 */
				background: transparent;
				color: #f3d6a1;
				font-size: 0.92em;
				letter-spacing: 0.06em;
				text-decoration: none;
				transition:
					background-color var(--dur-fast) ease,
					color var(--dur-fast) ease;
			}
			.radio-archive-link:hover {
				background: #f3d6a1; /* 与「收听最新一期」一致的金色实底 */
				color: #2b2024;
				text-decoration: none;
			}
			.radio-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 24px;
				width: 100%;
			}
			/* 电台四图：正方形、填充满、可点击 */
			.radio-slot {
				aspect-ratio: 1 / 1;
				border-radius: 0;
				overflow: hidden;
				position: relative;
				display: block;
				text-decoration: none;
			}
			.radio-slot img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				filter: saturate(0.95); /* 轻微降饱和，更克制 */
			}
			.radio-slot-note {
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				padding: 0.7em 0.9em;
				background: rgba(43, 32, 36, 0.58);
				color: rgba(246, 244, 240, 0.88);
				font-size: 0.74em;
				line-height: 1.45;
				opacity: 0;
				transform: translateY(100%);
				transition:
					opacity var(--dur-fast) ease,
					transform var(--dur-fast) var(--ease-out-quart);
				pointer-events: none;
			}
			.radio-slot:hover .radio-slot-note,
			.radio-slot:focus-visible .radio-slot-note {
				opacity: 1;
				transform: translateY(0);
			}

			@media (max-width: 820px) {
				.poster {
					grid-template-columns: 1fr;
				}
				.poster-left {
					padding: 3rem 1.5rem 1rem;
				}
				.report-panel {
					padding: 1rem 1.5rem 2rem;
					justify-content: flex-start;
				}
				.hl-row-cards {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				/* 移动端精简：只保留最新一期的卡片行 + 最近两条更新 */
				.hl-row[data-mobile-hide],
				.recent-list li[data-mobile-hide] {
					display: none;
				}
				.radio {
					grid-template-columns: 1fr;
				}
				.radio-left {
					padding: 3rem 1.5rem 1rem;
					justify-content: flex-start;
				}
				.radio-panel {
					padding: 1rem 1.5rem 3rem;
				}
				.radio-archive-link {
					right: 1.5rem;
					bottom: 1.5rem;
				}
			}
			/* 超窄屏（手机竖屏）：高亮卡两列太挤，改单列 */
			@media (max-width: 480px) {
				.hl-row-cards {
					grid-template-columns: 1fr;
					gap: 18px;
				}
				.hl-row {
					gap: 8px;
				}
				.hl-grid {
					gap: 28px;
				}
			}
			/* 2K/高分辨率（≥2000px）：卡片随屏幕放大，保持饱满；恢复 4:3 并放宽右区 */
			@media (min-width: 2000px) {
				.report-panel {
					max-width: none; /* 不设上限，让卡片随右区宽度自然放大 */
				}
				.hl-card {
					aspect-ratio: 4 / 3; /* 恢复原比例 */
				}
				.hl-card-img {
					flex: 17; /* 延续加高后的文字区比例 */
				}
				.hl-card-body {
					padding: 0.5em 1em 0.7em;
				}
				.radio-panel {
					max-width: none;
				}
			}
		</style>
	</head>
	<body>
		<Rail />
		<main class="home-main">
			<section class="poster" id="poster">
				<Image
					class="poster-bg"
					src={bg}
					format="webp"
					widths={[640, 960, 1280, 1672]}
					sizes="100vw"
					quality="high"
					loading="eager"
					fetchpriority="high"
					decoding="async"
					alt=""
					aria-hidden="true"
				/>
				<div class="poster-left">
					<div class="signals" data-animate>
						<span class="r"></span><span class="y"></span><span class="g"></span>
					</div>
					<p class="poster-kicker" data-animate>OBSERVATION WEEKLY · 观测周报</p>
					<h1 class="poster-title" data-animate>{SITE_TITLE}</h1>
					<p class="poster-tagline" data-animate>
					{descParts[0]}：<br />{descParts.slice(1).join('：')}
				</p>
					<FourAMWatch />
					{
						latest && (
							<a class="poster-cta" data-animate href={`/issue/${latest.id}/`}>
								阅读最新一期 · 第 {latest.data.issue} 期
							</a>
						)
					}
					<div class="recent" data-animate>
						<h2 class="recent-title">近期更新</h2>
						<ul class="recent-list">
							{
								recentUpdates.map((u, i) => (
									<li data-mobile-hide={i > 1 ? '1' : undefined}>
										<a class="row" href={u.href}>
											<span class="date">{u.date}</span>
											<span class="title">{u.title}</span>
										</a>
									</li>
								))
							}
						</ul>
					</div>
					<a class="scroll-hint" href="#info" aria-label="向下查看更多" title="向下查看更多">
						<svg
							viewBox="0 0 24 24"
							width="20"
							height="20"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M5 9l7 7 7-7"></path>
						</svg>
					</a>
				</div>

				<div class="report-panel">
					{
						rows.length > 0 ? (
							<div class="hl-grid">
								{
									rows.map((row, i) => (
										<div class="hl-row" data-mobile-hide={i > 0 ? '1' : undefined}>
											<a class="hl-row-label" href={`/issue/${row.issue.id}/`}>
												第 {row.issue.data.issue} 期 · {row.issue.data.title}
											</a>
											<div class="hl-row-cards">
												{
													row.cards.map((h) => (
														<a
															class="hl-card"
															href={`/issue/${row.issue.id}/#${encodeURIComponent(h.target || h.title)}`}
														>
															{h.image && <img class="hl-card-img" src={h.image} alt="" loading="lazy" />}
															<div class="hl-card-body">
																<h4>{h.title}</h4>
																{h.points.length > 0 && (
																	<ul>
																		{h.points.map((p) => (
																			<li>{p}</li>
																		))}
																	</ul>
																)}
																<span class="hl-card-enter">进入</span>
															</div>
														</a>
													))
												}
											</div>
										</div>
									))
								}
							</div>
						) : (
							<p>暂无观测记录</p>
						)
					}
				</div>
			</section>

			<VideoCinema />

			<section class="radio" id="radio" style="position: relative; padding-bottom: 90px; box-sizing: border-box;">
				<Image
					class="radio-bg"
					src={radioBg}
					format="webp"
					widths={[640, 960, 1280, 1672]}
					sizes="100vw"
					quality="high"
					loading="lazy"
					decoding="async"
					alt=""
					aria-hidden="true"
				/>
				<div class="radio-left">
					<span class="radio-kicker" data-animate>早间电台 · Morning Radio</span>
					<h2 class="radio-title" data-animate>四时小路的早间电台</h2>
					<p class="radio-desc" data-animate>
						每周一清晨，小路在电波里等你。这里是早间电台版块，四时小路的每一份安利，都是颇具她个人风格的色彩，希望你听的开心。
					</p>
					<a class="radio-cta" data-animate href={radioLatestUrl} target="_blank" rel="noopener noreferrer">收听最新一期</a>
				</div>
				<div class="radio-panel">
					<RadioAlbums />
				</div>
				<a
					class="radio-archive-link"
					href="/radio"
					style="position: absolute; left: auto; top: auto; right: clamp(24px, 3vw, 40px); bottom: 144px; z-index: 3;"
				>观测往期收录</a>
			</section>

			<section class="info" id="info">
				<div class="info-inner">
					<h2 data-animate>往期观测</h2>
					<ul class="issue-list">
						{
							rest.map((issue) => (
								<li data-animate>
									<a class="row" href={`/issue/${issue.id}/`}>
										<span class="no">第 {issue.data.issue} 期</span>
										<span class="title">{issue.data.title}</span>
										<span class="date">
											{issue.data.period || <FormattedDate date={issue.data.pubDate} />}
										</span>
									</a>
								</li>
							))
						}
					</ul>
					<a class="archive-link" href="/archive" data-animate>查看全部归档</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
