---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import FourAMWatch from '../components/FourAMWatch.astro';
import { getCollection, render } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const issues = (await getCollection('issues')).sort((a, b) => b.data.issue - a.data.issue);
const latest = issues[0];
const rest = issues.slice(1);
const { Content } = latest ? await render(latest) : { Content: null };
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main.home-main {
				max-width: none;
				margin: 0;
				padding: 0;
			}

			/* ===== 上半：报告左右两页（暗红黑） ===== */
			.poster {
				min-height: 100svh;
				min-height: 100vh;
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
				background:
					radial-gradient(900px 480px at 85% -8%, rgba(255, 34, 49, 0.16), transparent 60%),
					radial-gradient(700px 420px at -10% 110%, rgba(242, 165, 184, 0.08), transparent 55%),
					#0c0505;
				color: #f6ebe8;
			}

			/* 左页：封面信息（左上，左对齐，左侧留约 50px） */
			.poster-left {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				justify-content: flex-start;
				text-align: left;
				padding: 4.5rem 1.5rem 2.5rem 3.125rem;
			}
			.poster .signals {
				display: inline-flex;
				align-items: center;
				gap: 0.7em;
				padding: 0.55em 0.9em;
				margin-bottom: 1.6em;
				background: #1a0f0f;
				border-radius: 12px;
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
			}
			.poster .signals span {
				width: 14px;
				height: 14px;
				border-radius: 50%;
			}
			.poster .signals .r {
				background: #ff2231;
			}
			.poster .signals .y {
				background: #ffd100;
			}
			.poster .signals .g {
				background: #00a651;
			}
			.poster-title {
				font-family: var(--font-serif);
				font-size: clamp(2rem, 4.5vw, 3.4rem);
				line-height: 1.2;
				margin: 0 0 0.5em;
				color: #f6ebe8;
				letter-spacing: 0.04em;
			}
			.poster-tagline {
				color: #b9b1ac;
				max-width: 30em;
				margin: 0 0 1em;
			}
			.poster-cta {
				display: inline-block;
				margin-top: 2em;
				padding: 0.7em 2em;
				border: 1px solid #ff2231;
				border-radius: 999px;
				color: #f6ebe8;
				text-decoration: none;
				transition:
					background-color var(--dur-fast) ease,
					color var(--dur-fast) ease;
			}
			.poster-cta:hover {
				background: #ff2231;
				color: #fff;
				text-decoration: none;
			}
			.scroll-hint {
				align-self: center;
				margin-top: auto;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 2.8em;
				height: 2.8em;
				border-radius: 12px;
				color: #b06a78;
				background: rgba(255, 34, 49, 0.07);
				border: 1px solid rgba(255, 34, 49, 0.22);
				animation: hint-breathe 2.6s ease-in-out infinite;
				text-decoration: none;
			}
			.scroll-hint:hover {
				color: #ff2231;
			}
			@keyframes hint-breathe {
				0%,
				100% {
					transform: translateY(0);
					opacity: 0.9;
				}
				50% {
					transform: translateY(7px);
					opacity: 0.55;
				}
			}

			/* 右页：可独立滚动的周报窗口（悬浮于上半区，不延伸到底部） */
			.report-panel {
				display: flex;
				align-items: flex-start;
				padding: 2.5rem 3rem 0 1rem;
			}
			.report-page {
				width: 100%;
				height: min(72vh, 760px);
				overflow-y: auto;
				background: #f6f4f0;
				color: #242833;
				border-radius: 10px;
				padding: 2.2em 2em 2.5em;
				box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
			}
			.report-meta {
				color: #8b8680;
				font-size: 0.85em;
				margin-bottom: 0.5em;
			}
			.report-page h3 {
				font-family: var(--font-serif);
				color: #242833;
				font-size: 1.5em;
				margin: 0 0 1.2em;
			}
			.report-page :global(.prose) {
				color: #242833;
			}
			.report-page :global(.prose h2),
			.report-page :global(.prose h3),
			.report-page :global(.prose h4) {
				color: #242833;
			}
			.report-page :global(.prose a) {
				color: #c8102e;
			}
			.report-page :global(.prose blockquote) {
				color: #6b7180;
				border-left-color: #c8102e;
			}
			.report-page :global(.prose code) {
				background: #eae6de;
			}

			/* ===== 下半：往期观测（yorushika 式暖白信息区） ===== */
			.info {
				min-height: 100svh;
				min-height: 100vh;
				padding: 5em 1.5em 4em;
				background: #f6f4f0;
				color: #242833;
				display: flex;
				flex-direction: column;
				align-items: center;
			}
			.info-inner {
				width: 720px;
				max-width: 100%;
			}
			.info h2 {
				font-family: var(--font-serif);
				font-size: 1.8em;
				text-align: center;
				margin-bottom: 1.5em;
				color: #242833;
				border: none;
			}
			.issue-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.issue-list li {
				border-bottom: 1px solid #e3ded5;
			}
			.issue-list .row {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 1em 0.4em;
				color: #242833;
				text-decoration: none;
			}
			.issue-list .row:hover .title {
				color: #c8102e;
			}
			.issue-list .no {
				color: #c8102e;
				font-weight: 700;
				min-width: 5em;
				font-size: 0.95em;
			}
			.issue-list .title {
				flex: 1;
			}
			.issue-list .date {
				color: #8b8680;
				font-size: 0.85em;
			}
			.archive-link {
				display: block;
				text-align: center;
				margin-top: 2em;
				font-size: 0.95em;
				color: #c8102e;
				text-decoration: none;
			}

			@media (max-width: 820px) {
				.poster {
					grid-template-columns: 1fr;
				}
				.poster-left {
					padding: 3rem 1.5rem 1rem;
				}
				.report-panel {
					padding: 1rem 1.5rem 2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home-main">
			<section class="poster">
				<div class="poster-left">
					<div class="signals" data-animate>
						<span class="r"></span><span class="y"></span><span class="g"></span>
					</div>
					<h1 class="poster-title" data-animate>{SITE_TITLE}</h1>
					<p class="poster-tagline" data-animate>{SITE_DESCRIPTION}</p>
					<FourAMWatch />
					{
						latest && (
							<a class="poster-cta" data-animate href={`/issue/${latest.id}/`}>
								阅读最新一期 · 第 {latest.data.issue} 期
							</a>
						)
					}
					<a class="scroll-hint" href="#info" aria-label="向下查看更多" title="向下查看更多">
						<svg
							viewBox="0 0 24 24"
							width="20"
							height="20"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M5 9l7 7 7-7"></path>
						</svg>
					</a>
				</div>

				<div class="report-panel">
					<div class="report-page" data-lenis-prevent>
						{
							latest ? (
								<>
									<p class="report-meta">
										第 {latest.data.issue} 期 · <FormattedDate date={latest.data.pubDate} /> · {latest.data.author}
									</p>
									<h3>{latest.data.title}</h3>
									<div class="prose">
										<Content />
									</div>
								</>
							) : (
								<p>暂无观测记录</p>
							)
						}
					</div>
				</div>
			</section>

			<section class="info" id="info">
				<div class="info-inner">
					<h2 data-animate>往期观测</h2>
					<ul class="issue-list">
						{
							rest.map((issue) => (
								<li data-animate>
									<a class="row" href={`/issue/${issue.id}/`}>
										<span class="no">第 {issue.data.issue} 期</span>
										<span class="title">{issue.data.title}</span>
										<span class="date">
											<FormattedDate date={issue.data.pubDate} />
										</span>
									</a>
								</li>
							))
						}
					</ul>
					<a class="archive-link" href="/archive" data-animate>查看全部归档 →</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
