---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Rail from '../components/Rail.astro';
import FourAMWatch from '../components/FourAMWatch.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import bg from '../assets/Background_test01.png';

const issues = (await getCollection('issues')).sort((a, b) => b.data.issue - a.data.issue);
const latest = issues[0];
const second = issues[1];
const rest = issues.slice(1);
// 首页右区：每行一期的高亮卡（每期最多取前 2 条）
const rows = [latest, second]
	.filter(Boolean)
	.map((issue) => ({ issue, cards: issue.data.highlights.slice(0, 2) }))
	.filter((r) => r.cards.length > 0);
// 标签语在"："后换行（只影响首页展示）
const descParts = SITE_DESCRIPTION.split('：');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main.home-main {
				max-width: none;
				margin: 0;
				padding: 0;
			}

			/* ===== 上半：报告左右两页（暗红黑） ===== */
			.poster {
				position: relative;
				overflow: hidden;
				min-height: 100svh;
				min-height: 100vh;
				display: grid;
				grid-template-columns: minmax(0, calc(50% + 160px)) minmax(0, calc(50% - 160px));
				background-color: #0c0505;
				color: #f6ebe8;
			}
			.poster-bg {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				opacity: 0.9;
				pointer-events: none;
			}
			.poster-left,
			.report-panel {
				position: relative;
				z-index: 1;
			}

			/* 左页：封面信息（左上，左对齐，左侧留约 50px） */
			.poster-left {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				justify-content: flex-start;
				text-align: left;
				padding: 4.5rem 1.5rem 2.5rem 1.5rem;
			}
			.poster .signals {
				display: inline-flex;
				align-items: center;
				gap: 0.7em;
				padding: 0.55em 0.9em;
				margin-bottom: 1.6em;
				background: #1a0f0f;
				border-radius: 12px;
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
			}
			.poster .signals span {
				width: 14px;
				height: 14px;
				border-radius: 50%;
			}
			.poster .signals .r {
				background: #ff2231;
			}
			.poster .signals .y {
				background: #ffd100;
			}
			.poster .signals .g {
				background: #00a651;
			}
			.poster-title {
				font-family: var(--font-serif);
				font-size: clamp(2rem, 4.5vw, 3.4rem);
				line-height: 1.2;
				margin: 0 0 0.5em;
				color: #f6ebe8;
				letter-spacing: 0.04em;
			}
			.poster-tagline {
				color: #b9b1ac;
				max-width: 30em;
				margin: 0 0 1em;
			}
			.poster-cta {
				display: inline-block;
				margin-top: 2em;
				padding: 0.7em 2em;
				border: 1px solid #ff2231;
				border-radius: 999px;
				color: #f6ebe8;
				text-decoration: none;
				transition:
					background-color var(--dur-fast) ease,
					color var(--dur-fast) ease;
			}
			.poster-cta:hover {
				background: #ff2231;
				color: #fff;
				text-decoration: none;
			}
			.scroll-hint {
				align-self: center;
				margin-top: auto;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 2.8em;
				height: 2.8em;
				border-radius: 12px;
				color: #b06a78;
				background: rgba(255, 34, 49, 0.07);
				border: 1px solid rgba(255, 34, 49, 0.22);
				animation: hint-breathe 2.6s ease-in-out infinite;
				text-decoration: none;
			}
			.scroll-hint:hover {
				color: #ff2231;
			}
			@keyframes hint-breathe {
				0%,
				100% {
					transform: translateY(0);
					opacity: 0.9;
				}
				50% {
					transform: translateY(7px);
					opacity: 0.55;
				}
			}

			/* 右区：两期高亮卡（无预览窗，白卡直接浮在暗底上） */
			.report-panel {
				display: flex;
				justify-content: flex-start;
				align-items: flex-start;
				padding: 2rem 2.5rem 0 0.5rem;
			}
			.hl-grid {
				display: flex;
				flex-direction: column;
				gap: 34px;
			}
			.hl-row {
				display: flex;
				flex-direction: column;
				gap: 10px;
			}
			.hl-row-label {
				color: #b9b1ac;
				font-size: 0.85em;
				letter-spacing: 0.04em;
				text-decoration: none;
			}
			.hl-row-label:hover {
				color: #ff2231;
				text-decoration: none;
			}
			.hl-row-cards {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 30px;
			}
			.hl-card {
				display: flex;
				flex-direction: column;
				aspect-ratio: 4 / 3;
				background: #fff;
				border: 1px solid #e3ded5;
				border-radius: 10px;
				overflow: hidden;
				text-decoration: none;
				color: #242833;
				transition:
					transform 0.25s ease,
					box-shadow 0.25s ease;
			}
			.hl-card:hover {
				transform: translateY(-2px);
				box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
				text-decoration: none;
			}
			.hl-card-img {
				width: 100%;
				flex: 3;
				object-fit: cover;
				min-height: 0;
				display: block;
			}
			.hl-card-body {
				flex: 1;
				padding: 0.5em 1em 0.7em;
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.15em;
				overflow: hidden;
			}
			.hl-card-body h4 {
				margin: 0;
				font-family: var(--font-serif);
				font-size: 0.95em;
				line-height: 1.25;
				color: #242833;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.hl-card-body ul {
				margin: 0;
				padding-left: 1.1em;
				color: #6b7180;
				font-size: 0.76em;
			}
			.hl-card-enter {
				margin-top: auto;
				color: #c8102e;
				font-size: 0.8em;
				font-weight: 600;
			}

			/* ===== 下半：往期观测（yorushika 式暖白信息区） ===== */
			.info {
				min-height: 120svh; /* 第二版加高 1.2 倍：滚动时有余地看完整背景 */
				min-height: 120vh;
				padding: 5em 1.5em 4em;
				background: #f6f4f0;
				color: #242833;
				display: flex;
				flex-direction: column;
				align-items: center;
			}
			.info-inner {
				width: 720px;
				max-width: 100%;
			}
			.info h2 {
				font-family: var(--font-serif);
				font-size: 1.8em;
				text-align: center;
				margin-bottom: 1.5em;
				color: #242833;
				border: none;
			}
			.issue-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.issue-list li {
				border-bottom: 1px solid #e3ded5;
			}
			.issue-list .row {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 1em 0.4em;
				color: #242833;
				text-decoration: none;
			}
			.issue-list .row:hover .title {
				color: #c8102e;
			}
			.issue-list .no {
				color: #c8102e;
				font-weight: 700;
				min-width: 5em;
				font-size: 0.95em;
			}
			.issue-list .title {
				flex: 1;
			}
			.issue-list .date {
				color: #8b8680;
				font-size: 0.85em;
			}
			.archive-link {
				display: block;
				text-align: center;
				margin-top: 2em;
				font-size: 0.95em;
				color: #c8102e;
				text-decoration: none;
			}

			/* ===== 第一点五版（早间电台）：渐变底 + 左介绍 + 右四图占位（预览） ===== */
			.radio {
				position: relative;
				overflow: hidden;
				min-height: 120svh; /* 加高 1.2 倍：滚动到第二版时有余地，减少上一版残留 */
				min-height: 120vh;
				display: grid;
				grid-template-columns: minmax(0, calc(50% + 160px)) minmax(0, calc(50% - 160px));
				background: linear-gradient(180deg, #b27685 0%, #beb09c 100%);
				color: #2b2024;
			}
			.radio-left {
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				justify-content: center;
				text-align: left;
				padding: 4.5rem 1.5rem;
			}
			.radio-kicker {
				font-size: 0.85em;
				letter-spacing: 0.22em;
				text-transform: uppercase;
				color: #6b4a52;
				margin-bottom: 1.2em;
			}
			.radio-title {
				font-family: var(--font-serif);
				font-size: clamp(2rem, 4.5vw, 3.2rem);
				line-height: 1.25;
				margin: 0 0 0.6em;
				color: #2b2024;
				letter-spacing: 0.04em;
			}
			.radio-desc {
				max-width: 30em;
				color: #4a3a40;
				margin: 0 0 1.6em;
				line-height: 1.9;
			}
			.radio-cta {
				display: inline-block;
				padding: 0.7em 2em;
				border: 1px solid #2b2024;
				border-radius: 999px;
				color: #2b2024;
				text-decoration: none;
				font-size: 0.95em;
				transition:
					background-color var(--dur-fast) ease,
					color var(--dur-fast) ease;
			}
			.radio-cta:hover {
				background: #2b2024;
				color: #f2ece2;
				text-decoration: none;
			}
			.radio-panel {
				display: flex;
				align-items: center;
				padding: 2.5rem;
			}
			.radio-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 24px;
				width: 100%;
			}
			/* 正方形空占位符：无圆角，虚线框，后续填图 */
			.radio-slot {
				aspect-ratio: 1 / 1;
				border: 1px dashed rgba(43, 32, 36, 0.4);
				border-radius: 0;
				background: rgba(255, 255, 255, 0.14);
				display: flex;
				align-items: center;
				justify-content: center;
				color: rgba(43, 32, 36, 0.45);
				font-size: 0.85em;
				letter-spacing: 0.1em;
			}

			@media (max-width: 820px) {
				.poster {
					grid-template-columns: 1fr;
				}
				.poster-left {
					padding: 3rem 1.5rem 1rem;
				}
				.report-panel {
					padding: 1rem 1.5rem 2rem;
					justify-content: flex-start;
				}
				.hl-row-cards {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.radio {
					grid-template-columns: 1fr;
				}
				.radio-left {
					padding: 3rem 1.5rem 1rem;
					justify-content: flex-start;
				}
				.radio-panel {
					padding: 1rem 1.5rem 3rem;
				}
			}
			/* 超窄屏（手机竖屏）：高亮卡两列太挤，改单列 */
			@media (max-width: 480px) {
				.hl-row-cards {
					grid-template-columns: 1fr;
					gap: 18px;
				}
				.hl-row {
					gap: 8px;
				}
				.hl-grid {
					gap: 28px;
				}
			}
		</style>
	</head>
	<body>
		<Rail />
		<main class="home-main">
			<section class="poster">
				<img class="poster-bg" src={bg.src} alt="" aria-hidden="true" />
				<div class="poster-left">
					<div class="signals" data-animate>
						<span class="r"></span><span class="y"></span><span class="g"></span>
					</div>
					<h1 class="poster-title" data-animate>{SITE_TITLE}</h1>
					<p class="poster-tagline" data-animate>
					{descParts[0]}：<br />{descParts.slice(1).join('：')}
				</p>
					<FourAMWatch />
					{
						latest && (
							<a class="poster-cta" data-animate href={`/issue/${latest.id}/`}>
								阅读最新一期 · 第 {latest.data.issue} 期
							</a>
						)
					}
					<a class="scroll-hint" href="#info" aria-label="向下查看更多" title="向下查看更多">
						<svg
							viewBox="0 0 24 24"
							width="20"
							height="20"
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M5 9l7 7 7-7"></path>
						</svg>
					</a>
				</div>

				<div class="report-panel">
					{
						rows.length > 0 ? (
							<div class="hl-grid">
								{
									rows.map((row) => (
										<div class="hl-row">
											<a class="hl-row-label" href={`/issue/${row.issue.id}/`}>
												第 {row.issue.data.issue} 期 · {row.issue.data.title} →
											</a>
											<div class="hl-row-cards">
												{
													row.cards.map((h) => (
														<a
															class="hl-card"
															href={`/issue/${row.issue.id}/#${encodeURIComponent(h.target || h.title)}`}
														>
															{h.image && <img class="hl-card-img" src={h.image} alt="" loading="lazy" />}
															<div class="hl-card-body">
																<h4>{h.title}</h4>
																{h.points.length > 0 && (
																	<ul>
																		{h.points.map((p) => (
																			<li>{p}</li>
																		))}
																	</ul>
																)}
																<span class="hl-card-enter">进入 ↗</span>
															</div>
														</a>
													))
												}
											</div>
										</div>
									))
								}
							</div>
						) : (
							<p>暂无观测记录</p>
						)
					}
				</div>
			</section>

			<section class="radio">
				<div class="radio-left">
					<span class="radio-kicker" data-animate>早间电台 · Morning Radio</span>
					<h2 class="radio-title" data-animate>四时小路的早间电台</h2>
					<p class="radio-desc" data-animate>
						每周一清晨，小路在电波里等你。这里是早间电台版块的预览占位文案——正式介绍与节目安排后续填充。
					</p>
					<a class="radio-cta" data-animate href="#info">收听占位 ↗</a>
				</div>
				<div class="radio-panel">
					<div class="radio-grid">
						<div class="radio-slot">施工中</div>
						<div class="radio-slot">施工中</div>
						<div class="radio-slot">施工中</div>
						<div class="radio-slot">施工中</div>
					</div>
				</div>
			</section>

			<section class="info" id="info">
				<div class="info-inner">
					<h2 data-animate>往期观测</h2>
					<ul class="issue-list">
						{
							rest.map((issue) => (
								<li data-animate>
									<a class="row" href={`/issue/${issue.id}/`}>
										<span class="no">第 {issue.data.issue} 期</span>
										<span class="title">{issue.data.title}</span>
										<span class="date">
											{issue.data.period || <FormattedDate date={issue.data.pubDate} />}
										</span>
									</a>
								</li>
							))
						}
					</ul>
					<a class="archive-link" href="/archive" data-animate>查看全部归档 →</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
