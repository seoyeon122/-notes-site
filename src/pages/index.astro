---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const issues = (await getCollection('issues')).sort((a, b) => b.data.issue - a.data.issue);
const latest = issues[0];
const rest = issues.slice(1);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 3.5em 0 2em;
			}
			.signals {
				display: flex;
				justify-content: center;
				gap: 0.5em;
				margin-bottom: 1.2em;
			}
			.signals span {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				box-shadow: 0 0 0 3px rgb(var(--gray-light));
			}
			.signals .y {
				background: var(--yellow);
			}
			.signals .g {
				background: var(--green);
			}
			.signals .b {
				background: var(--blue);
			}
			.hero h1 {
				font-family: var(--font-serif);
				font-size: 2.4em;
				margin: 0 0 0.4em;
			}
			.hero p {
				color: rgb(var(--gray));
				max-width: 34em;
				margin: 0 auto;
			}
			.latest-card {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				padding: 2em;
				margin: 2em 0 3em;
				transition: box-shadow 0.25s ease;
			}
			.latest-card:hover {
				box-shadow: var(--box-shadow);
			}
			.latest-card .label {
				color: var(--red);
				font-size: 0.85em;
				letter-spacing: 0.2em;
				margin-bottom: 0.8em;
			}
			.latest-card h2 {
				margin: 0 0 0.5em;
				border: none;
				font-size: 1.6em;
			}
			.latest-card .summary {
				color: var(--ink);
				margin-bottom: 1em;
			}
			.latest-card .meta {
				color: rgb(var(--gray));
				font-size: 0.85em;
				margin-bottom: 1.2em;
			}
			.latest-card .read-more {
				font-weight: 600;
			}
			.issue-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.issue-list li {
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.issue-list .row {
				display: flex;
				align-items: baseline;
				gap: 1em;
				padding: 0.9em 0.4em;
				color: var(--ink);
				text-decoration: none;
			}
			.issue-list .row:hover .title {
				color: var(--red);
			}
			.issue-list .no {
				color: var(--red);
				font-weight: 700;
				min-width: 5em;
				font-size: 0.95em;
			}
			.issue-list .title {
				flex: 1;
			}
			.issue-list .date {
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			.archive-link {
				display: block;
				text-align: right;
				margin-top: 1.2em;
				font-size: 0.92em;
			}
			@media (max-width: 480px) {
				.hero h1 {
					font-size: 1.9em;
				}
				.latest-card {
					padding: 1.4em;
				}
				.issue-list .no {
					min-width: 4em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="signals" data-animate>
					<span class="y"></span><span class="g"></span><span class="b"></span>
				</div>
				<h1 data-animate>{SITE_TITLE}</h1>
				<p data-animate>{SITE_DESCRIPTION}</p>
			</section>

			{
				latest && (
					<section class="latest-card" data-animate>
						<p class="label">最新观测 · 第 {latest.data.issue} 期</p>
						<h2>{latest.data.title}</h2>
						<p class="summary">{latest.data.summary || latest.data.title}</p>
						<p class="meta">
							<FormattedDate date={latest.data.pubDate} /> · {latest.data.author}
						</p>
						<a class="read-more" href={`/issue/${latest.id}/`}>阅读本期 →</a>
					</section>
				)
			}

			<section>
				<h2 data-animate>往期观测</h2>
				<ul class="issue-list">
					{
						rest.map((issue) => (
							<li>
								<a class="row" href={`/issue/${issue.id}/`} data-animate>
									<span class="no">第 {issue.data.issue} 期</span>
									<span class="title">{issue.data.title}</span>
									<span class="date">
										<FormattedDate date={issue.data.pubDate} />
									</span>
								</a>
							</li>
						))
					}
				</ul>
				{rest.length > 0 && (
					<a class="archive-link" href="/archive" data-animate>查看全部归档 →</a>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
