---
// 切片卡片：把正文里的 B 站视频链接变成卡片块
// 用法（在 .mdx 文件里）：<Clip title="标题" url="https://www.bilibili.com/video/BV..." />
interface Props {
	title: string;
	url: string;
}

const { title, url } = Astro.props;
---

<a class="clip" href={url} target="_blank" rel="noopener noreferrer">
	<span class="clip-play" aria-hidden="true">▶</span>
	<span class="clip-title">{title}</span>
</a>

<style>
	.clip {
		display: flex;
		align-items: center;
		gap: 0.7em;
		padding: 0.7em 1em;
		margin: 0.9em 0;
		border: 1px solid rgb(var(--gray-light));
		border-left: 3px solid var(--accent); /* 细一档 */
		border-radius: 2px; /* 收圆角 */
		background: transparent; /* 去底色 */
		text-decoration: none;
		color: var(--ink);
		transition: border-color 0.2s ease;
	}
	.clip:hover {
		border-color: var(--accent);
		text-decoration: none;
	}
	.clip-play {
		color: var(--accent);
		font-size: 0.8em;
		flex-shrink: 0;
	}
	.clip-title {
		flex: 1;
		font-size: 0.92em;
		color: var(--ink);
	}
</style>
