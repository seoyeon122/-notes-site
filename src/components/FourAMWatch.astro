---
// 「凌晨四点观测」：从 570 个真实地点（数据源自 KomichiTime 项目，
// 见 github.com/Badj0ey/KomichiTime，MIT License）里，找出此刻当地正好是
// 凌晨 04:00–04:59 的地点，随机展示一个；点击卡片可换一个。
// 四时小路是活跃在凌晨四点的都市传说。
---

<div class="four-am" data-animate data-four-am tabindex="0" role="button" aria-label="换一个地点" title="点击换一个">
	<p class="four-am-label">凌晨四点，此刻降临在</p>
	<p class="four-am-zone"><span id="four-am-zone">……</span></p>
	<p class="four-am-note">四时小路出没时刻 · 点击随机换一个</p>
</div>

<style>
	.four-am {
		margin: 1.5em 0 0;
		padding: 1em 1.25em;
		max-width: 26em;
		border: 1px solid rgba(246, 235, 232, 0.14);
		border-radius: 2px; /* 收圆角 */
		background: transparent; /* 去底色 */
		text-align: left;
		cursor: pointer;
		transition: border-color 0.25s ease;
	}
	.four-am:hover,
	.four-am:focus-visible {
		border-color: rgba(255, 34, 49, 0.55);
		outline: none;
	}
	.four-am-label {
		font-size: 0.82em;
		color: #b9b1ac;
		letter-spacing: 0.12em;
		margin-bottom: 0.4em;
	}
	.four-am-zone {
		font-family: var(--font-serif);
		font-size: 1.3em;
		font-weight: 400; /* 去粗体 */
		color: #f6ebe8;
		margin-bottom: 0.4em;
	}
	.four-am-note {
		font-size: 0.78em;
		color: #8b8580;
	}
</style>

<script>
	// 地点数据：{ n: 中文名, z: IANA 时区 }，570 条（countries/additionalRegions/ianaLocations 精简合并）
	// 数据来源：KomichiTime（github.com/Badj0ey/KomichiTime，MIT）
	let LOCATIONS = [];

	// 缓存 Intl 格式化器（每个时区一个，避免重复构造）
	const fmtCache = new Map();
	function hourInZone(date, zone) {
		let f = fmtCache.get(zone);
		if (!f) {
			f = new Intl.DateTimeFormat('en-GB', { timeZone: zone, hour: '2-digit', hourCycle: 'h23' });
			fmtCache.set(zone, f);
		}
		return Number(f.format(date));
	}

	// 此刻当地正好 04:00–04:59 的所有地点
	function fourAmCandidates(date = new Date()) {
		return LOCATIONS.filter((loc) => hourInZone(date, loc.z) === 4);
	}

	let currentId = null;
	function render(date = new Date()) {
		const el = document.getElementById('four-am-zone');
		if (!el) return;
		const candidates = fourAmCandidates(date);
		if (!candidates.length) {
			el.textContent = '此刻不在地球任何角落的四点';
			return;
		}
		// 换一个：避开当前显示的那个
		const pool = candidates.length > 1 && currentId != null
			? candidates.filter((c) => c.n !== currentId)
			: candidates;
		const pick = pool[Math.floor(Math.random() * pool.length)];
		currentId = pick.n;
		el.textContent = pick.n;
	}

	// 加载数据后首次渲染
	async function init() {
		try {
			const res = await fetch('/data/four-am.json');
			if (!res.ok) throw new Error(String(res.status));
			LOCATIONS = await res.json();
		} catch {
			const el = document.getElementById('four-am-zone');
			if (el) el.textContent = '地点数据暂不可用';
			return;
		}
		render();
	}

	// 点击换一个
	document.addEventListener('click', (e) => {
		const card = e.target?.closest('[data-four-am]');
		if (card) render();
	});

	// 每 30 秒重算（跨过整点 04:00→05:00 时自动切换地点）
	init();
	setInterval(render, 30 * 1000);
	document.addEventListener('astro:page-load', () => {
		currentId = null;
		init();
	});
</script>
