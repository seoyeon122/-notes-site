---
// 动效地基（全站动效管理器）
// 1. Lenis 平滑滚动
// 2. 滚动进场动画：给元素加 data-animate 属性即可
// 3. 兼容 ClientRouter 页面切换与系统"减少动态效果"设置
// 用法：<h1 data-animate>标题</h1>
---

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import Lenis from 'lenis';

	gsap.registerPlugin(ScrollTrigger);

	// 尊重系统"减少动态效果"设置：开启时关闭平滑滚动和进场动画
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduced) {
		// 1) 平滑滚动
		const lenis = new Lenis({ duration: 1.15 });
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((time) => lenis.raf(time * 1000));
		gsap.ticker.lagSmoothing(0);

		// 2) 滚动进场动画：每个元素独立触发
		//    data-animate-done 标记"已显示"的元素，防止重复初始化把它们再藏回去
		function setupReveals() {
			const targets = gsap.utils.toArray('[data-animate]:not([data-animate-done])');
			targets.forEach((el) => {
				gsap.fromTo(
					el,
					{ opacity: 0, y: 28 },
					{
						opacity: 1,
						y: 0,
						duration: 0.9,
						ease: 'power3.out',
						scrollTrigger: { trigger: el, start: 'top 88%', once: true },
						onComplete: () => {
							el.dataset.animateDone = '1';
						},
					}
				);
			});
		}

		// 3) 统一入口：清旧触发点 → 重建 → 刷新位置
		//    （实测：导航后走这条路径一切正常，说明"刷新触发点位置"是必需步骤）
		function initReveals() {
			ScrollTrigger.getAll().forEach((t) => t.kill());
			setupReveals();
			ScrollTrigger.refresh();
		}

		// 初次加载：立即初始化；等字体/图片布局稳定后再刷新触发点位置
		initReveals();
		window.addEventListener('load', () => ScrollTrigger.refresh());
		document.fonts?.ready.then(() => ScrollTrigger.refresh());

		// 4) ClientRouter 页面切换后重置。
		//    astro:page-load 在初次加载时也会触发一次，跳过它（初次加载已由上方处理），
		//    避免把正在进场动画中的元素重新藏回去。
		let firstLoad = true;
		document.addEventListener('astro:page-load', () => {
			if (firstLoad) {
				firstLoad = false;
				return;
			}
			initReveals();
		});
	}
</script>
