---
// 动效地基（全站动效管理器）
// 1. Lenis 平滑滚动
// 2. 滚动进场动画：给元素加 data-animate 属性即可
// 3. 兼容 ClientRouter 页面切换与系统"减少动态效果"设置
// 用法：<h1 data-animate>标题</h1>
---

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import Lenis from 'lenis';

	gsap.registerPlugin(ScrollTrigger);

	// 尊重系统"减少动态效果"设置：开启时关闭平滑滚动和进场动画
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (!reduced) {
		// 1) 平滑滚动
		const lenis = new Lenis({ duration: 1.15 });
		lenis.on('scroll', ScrollTrigger.update);
		gsap.ticker.add((time) => lenis.raf(time * 1000));
		gsap.ticker.lagSmoothing(0);

		// 2) 滚动进场动画
		//    每个元素独立触发；data-animate-done 标记"已显示"的元素，
		//    防止重复初始化（astro:page-load 初次加载也会触发一次）把已显示的再藏回去。
		function setupReveals() {
			const targets = gsap.utils.toArray('[data-animate]:not([data-animate-done])');
			targets.forEach((el) => {
				gsap.fromTo(
					el,
					{ opacity: 0, y: 28 },
					{
						opacity: 1,
						y: 0,
						duration: 0.9,
						ease: 'power3.out',
						scrollTrigger: { trigger: el, start: 'top 88%', once: true },
						onComplete: () => {
							el.dataset.animateDone = '1';
						},
					}
				);
			});
		}

		setupReveals();

		// 3) 网页字体加载完可能引起布局偏移，刷新一次触发点位置
		document.fonts?.ready.then(() => ScrollTrigger.refresh());

		// 4) ClientRouter 页面切换后：清掉旧触发点、重新初始化
		document.addEventListener('astro:page-load', () => {
			ScrollTrigger.getAll().forEach((t) => t.kill());
			setupReveals();
			ScrollTrigger.refresh();
		});
	}
</script>
