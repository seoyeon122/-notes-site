---
// 左侧栏（装订脊）：站名竖排 + 竖排信号灯 + 导航 + 明暗切换
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const links = [
	{ href: '/', label: '首页' },
	{ href: '/archive', label: '归档' },
	{ href: '/about', label: '关于' },
];
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
// 阅读页（周报/关于）固定浅色，明暗切换按钮不显示
const isReading = pathname.startsWith('/issue/') || pathname === '/about';
---

<aside class="rail">
	<span class="rail-brand" aria-hidden="true">四时小路</span>
	<div class="rail-signals" aria-hidden="true">
		<span class="r"></span><span class="y"></span><span class="g"></span>
	</div>
	<nav class="rail-nav">
		{
			links.map((l) => (
				<a href={l.href} class:list={{ active: isActive(l.href) }}>
					{l.label}
				</a>
			))
		}
	</nav>
	{
		!isReading && (
			<div class="rail-toggle">
				<ThemeToggle />
			</div>
		)
	}
</aside>

<style>
	.rail {
		position: fixed;
		top: 0;
		left: 0;
		bottom: 0;
		width: 80px;
		z-index: 90;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.4em;
		padding: 1.5em 0 1.5em;
		background: #0c0505;
		border-right: 1px solid rgba(246, 235, 232, 0.1);
		view-transition-name: rail; /* 过渡时单独快照，不参与页面渐隐渐显 */
	}
	.rail-brand {
		font-family: var(--font-serif);
		color: #e6e2d8;
		font-size: 13px;
		line-height: 1.55;
		text-align: center;
		letter-spacing: 0.1em;
		writing-mode: vertical-rl; /* 竖排站名（桌面）；窄屏在下方媒体查询里改回横排 */
	}
	.rail-signals {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.rail-signals span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}
	.rail-signals .r {
		background: #ff2231;
	}
	.rail-signals .y {
		background: #ffd100;
	}
	.rail-signals .g {
		background: #00a651;
	}
	.rail-nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6em;
		margin-top: 0.5em;
	}
	.rail-nav a {
		display: block;
		padding: 0.3em 0.9em;
		color: #e6e2d8; /* 比白色偏米灰 */
		font-size: 0.9em;
		letter-spacing: 0.18em;
		text-decoration: none;
		border-left: 3px solid transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	.rail-nav a:hover {
		color: #ff2231;
		text-decoration: none;
	}
	.rail-nav a.active {
		color: #f6ebe8;
		border-left-color: #ff2231;
	}
	.rail-toggle {
		margin-top: auto;
	}

	/* ===== 移动端（≤820px）：左侧装订脊 → 顶部横栏 ===== */
	@media (max-width: 820px) {
		.rail {
			top: 0;
			left: 0;
			right: 0;
			bottom: auto;
			width: 100%;
			height: var(--rail-h, 60px);
			flex-direction: row;
			align-items: center;
			justify-content: flex-start;
			gap: 1em;
			padding: 0 1em;
			border-right: none;
			border-bottom: 1px solid rgba(246, 235, 232, 0.1);
		}
		.rail-brand {
			writing-mode: initial; /* 站名改横排 */
			font-size: 15px;
			letter-spacing: 0.2em;
		}
		.rail-signals {
			display: none; /* 顶栏空间有限，信号灯先隐藏（想保留可改成横排小灯） */
		}
		.rail-nav {
			flex-direction: row;
			align-items: center;
			gap: 0.3em;
			margin-top: 0;
		}
		.rail-nav a {
			border-left: none;
			border-bottom: 3px solid transparent;
			padding: 0.3em 0.6em;
		}
		.rail-nav a.active {
			border-left-color: transparent;
			border-bottom-color: #ff2231;
		}
		.rail-toggle {
			margin-top: 0;
			margin-left: auto; /* 推到最右 */
		}
	}
</style>
