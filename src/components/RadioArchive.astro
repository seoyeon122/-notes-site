---
import { RADIO_EPISODES, RADIO_DETAIL_COPY as copy } from '../consts';
// 归档页显示【全部】期数（含已下架的第 1 期），不过滤 hidden
const allEpisodes = RADIO_EPISODES;
---

<div class="archive-browser" data-radio-archive>
  <div class="archive-stack" data-stack>
    {allEpisodes.map((ep) => (
      <button class="arch-card" type="button" data-album={ep.issue} aria-expanded="false"
        aria-controls={`arch-detail-${ep.issue}`} aria-label={`第 ${ep.issue} 期 · ${ep.album}`}>
        <img src={ep.image} alt={ep.album} loading="lazy" width="480" height="480" />
        <span class="arch-meta">
          <span class="arch-no">第 {ep.issue} 期</span>
          <span class="arch-album">{ep.album}</span>
        </span>
      </button>
    ))}
  </div>
  {allEpisodes.map((ep) => (
    <section class="arch-detail" id={`arch-detail-${ep.issue}`} aria-labelledby={`arch-title-${ep.issue}`} hidden>
      <button type="button" class="arch-back" data-close>{copy.back}</button>
      <div class="arch-body">
        <img class="arch-cover" src={ep.image} alt={ep.album} width="480" height="480" />
        <div class="arch-info">
          <p class="arch-eyebrow">MORNING RADIO · 第 {ep.issue} 期</p>
          <h2 id={`arch-title-${ep.issue}`}>{ep.album.split(' / ')[0]}</h2>
          <p class="arch-artist">{ep.album.split(' / ').slice(1).join(' / ')}</p>
          <p class="arch-desc">{ep.description}</p>
          <div class="arch-trackhead">
            <h3>{copy.tracks}</h3>
            {ep.trackNote && <span>{ep.trackNote}</span>}
          </div>
          <ol class="arch-tracks">
            {ep.tracks.map((track, index) => (
              <li><span>{String(index + 1).padStart(2, '0')}</span>{track}</li>
            ))}
          </ol>
          <a class="arch-listen" href={ep.url} target="_blank" rel="noopener noreferrer">{copy.listen}</a>
        </div>
      </div>
    </section>
  ))}
</div>

<style>
  /* ===== 归档浏览器：常态 = 240px 封面网格（番剧索引式，全宽居中） ===== */
  .archive-browser { position: relative; min-height: 480px; }
  .archive-stack {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 240px));
    justify-content: center;
    gap: 1.6em;
    transition: max-width 0ms, margin-left 0ms; /* 布局切换即时，交给 JS FLIP */
  }
  .arch-card {
    position: relative;
    display: block;
    width: 240px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    will-change: transform;
  }
  .arch-card img {
    display: block;
    width: 240px;
    height: 240px;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid rgb(var(--gray-light));
    filter: saturate(0.95);
  }
  .arch-meta { display: block; margin-top: 0.6em; }
  .arch-no {
    display: block;
    font-size: 0.76em;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 0.15em;
  }
  .arch-album {
    display: block;
    font-family: var(--font-serif);
    font-size: 0.95em;
    line-height: 1.4;
    color: var(--ink);
  }

  /* ===== 展开态：网格靠右并缩小，为左侧详情让位 ===== */
  .archive-browser.open .archive-stack {
    justify-content: flex-start;
    max-width: 42%;
    margin-left: auto;
    grid-template-columns: repeat(auto-fill, minmax(150px, 150px));
    gap: 1.1em;
  }
  .archive-browser.open .arch-card { width: 150px; }
  .archive-browser.open .arch-card img { width: 150px; height: 150px; }
  .archive-browser.open .arch-meta { margin-top: 0.45em; }

  /* 抽出的源卡片：脱离文档流、钉在原位，等 JS 处理 */
  .arch-card.is-source {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    pointer-events: none;
    margin: 0;
  }

  .arch-detail {
    position: absolute;
    top: 0;
    left: 0;
    width: min(56%, 720px);
    z-index: 2;
    color: #fff;
    padding: 10px 26px 30px;
    box-sizing: border-box;
    background: rgba(12, 8, 10, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 18px 54px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transform-origin: top left;
    pointer-events: none; /* 动画中不可点，动画后恢复 */
  }
  .arch-detail[hidden] { display: none; }
  .arch-detail.ready { opacity: 1; pointer-events: auto; }

  .arch-back {
    display: block;
    min-height: 44px;
    padding: 0;
    margin: 0 0 8px;
    background: none;
    border: 0;
    color: rgba(255, 255, 255, 0.85);
    font: inherit;
    font-size: 0.78em;
    cursor: pointer;
  }
  /* 左封面 + 右信息 两栏 */
  .arch-body {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }
  .arch-cover {
    display: block;
    width: 220px;
    height: 220px;
    object-fit: cover;
    filter: saturate(0.95);
  }
  .arch-info { min-width: 0; }
  .arch-eyebrow {
    margin: 0 0 8px;
    font-size: 0.68em;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.7);
  }
  .arch-detail h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.6em;
    font-weight: 400;
    line-height: 1.35;
    color: #fff;
    overflow-wrap: anywhere;
  }
  .arch-artist { margin: 6px 0 0; font-size: 0.85em; color: rgba(255,255,255,0.75); }
  .arch-desc { margin: 16px 0; font-size: 0.85em; line-height: 1.8; color: rgba(255,255,255,0.88); white-space: pre-line; }
  .arch-trackhead {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
    gap: 6px; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.3);
  }
  .arch-trackhead h3 { margin: 0; font-size: 0.9em; color: #fff; font-weight: 400; }
  .arch-trackhead > span { font-size: 0.62em; color: rgba(255,255,255,0.68); }
  .arch-tracks { list-style: none; padding: 0; margin: 0 0 22px; }
  .arch-tracks li {
    display: flex; gap: 18px; padding: 9px 0;
    border-bottom: 1px solid rgba(255,255,255,0.16);
    font-size: 0.85em;
  }
  .arch-tracks li span { color: rgba(255,255,255,0.6); font-family: var(--font-num); }
  .arch-listen {
    display: inline-flex; align-items: center; min-height: 44px; box-sizing: border-box;
    padding: 9px 20px; border: 1px solid rgba(255,255,255,0.5); color: #fff;
    text-decoration: none; font-size: 0.82em;
  }
  .arch-listen:hover { background: rgba(255,255,255,0.15); text-decoration: none; }

  button:focus-visible, a:focus-visible { outline: 2px solid rgba(255,255,255,0.7); outline-offset: 3px; }

  /* 手机：不做左右避让，详情全宽堆叠 */
  @media (max-width: 820px) {
    .archive-browser.open .archive-stack {
      max-width: 100%;
      margin-left: 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .archive-browser.open .arch-card { width: auto; }
    .archive-browser.open .arch-card img { width: 100%; height: auto; aspect-ratio: 1; }
    .arch-detail { position: static; width: 100%; max-width: none; margin: 0 0 18px; opacity: 1; }
    .arch-body { grid-template-columns: 1fr; gap: 14px; }
    .arch-cover { width: 160px; height: 160px; }
  }
</style>

<script>
  function setupArchive() {
    document.querySelectorAll<HTMLElement>('[data-radio-archive]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = 'true';
      const stack = root.querySelector<HTMLElement>('[data-stack]')!;
      const cards = [...root.querySelectorAll<HTMLButtonElement>('[data-album]')];
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      const animations = new Set<Animation>();
      let open = false;
      let sourceCard: HTMLButtonElement | null = null;
      let detailEl: HTMLElement | null = null;

      const play = (el: Element, frames: Keyframe[], dur: number, delay = 0) => {
        const a = el.animate(frames, { duration: reduced.matches ? 0 : dur, delay: reduced.matches ? 0 : delay, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'both' });
        animations.add(a);
        return a.finished.catch(() => {});
      };
      const clearAnims = () => { animations.forEach((a) => a.cancel()); animations.clear(); };
      // 元素相对 root 的几何
      const g = (el: Element) => {
        const r = el.getBoundingClientRect();
        const h = root.getBoundingClientRect();
        return { x: r.left - h.left, y: r.top - h.top, w: r.width, h: r.height };
      };

      /** FLIP：让某组卡片从旧位置平滑到新位置 */
      function flip(group: HTMLButtonElement[], before: Map<Element, {x:number;y:number;w:number;h:number}>, dur: number) {
        group.forEach((c) => {
          const a = before.get(c)!;
          const b = g(c);
          const dx = a.x - b.x, dy = a.y - b.y, sx = a.w / b.w, sy = a.h / b.h;
          if (Math.abs(dx) < 1 && Math.abs(dy) < 1 && Math.abs(sx - 1) < 0.01 && Math.abs(sy - 1) < 0.01) return;
          void play(c, [
            { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`, transformOrigin: 'top left' },
            { transform: 'none' },
          ], dur);
        });
      }

      async function openDetail(button: HTMLButtonElement) {
        if (open) return;
        open = true;
        sourceCard = button;
        detailEl = root.querySelector<HTMLElement>(`#arch-detail-${button.dataset.album}`)!;

        // 1) 记录所有卡片当前位置（含被点中的）
        const before = new Map(cards.map((c) => [c, g(c)]));
        const src = before.get(button)!;

        // 锁定容器高度：展开后详情较高，需撑高容器让底部信息下移（用内联 height 锁定）
        const gridH = g(stack).h;
        root.style.minHeight = `${gridH}px`;

        // 2) 切换布局：详情先显示以参与布局，量取最终位置
        root.classList.add('open');
        detailEl.hidden = false;
        const detailBox = g(detailEl);
        const detailH = detailEl.offsetHeight;
        // 撑高到「详情 vs 网格」中较高者
        root.style.minHeight = `${Math.max(gridH, detailH)}px`;

        // 把被点中的卡片钉回旧位置（脱离流）
        button.classList.add('is-source');
        button.style.left = `${src.x}px`;
        button.style.top = `${src.y}px`;
        button.style.width = `${src.w}px`;
        button.style.height = `${src.h}px`;
        button.setAttribute('aria-expanded', 'true');

        // 3) 详情放大 + 其余卡片 FLIP 并行（不再 await 详情后才 FLIP）
        const others = cards.filter((c) => c !== button);
        const sx = src.w / detailBox.w, sy = src.h / detailBox.h;
        const detailAnim = play(detailEl, [
          { transform: `translate(${src.x - detailBox.x}px, ${src.y - detailBox.y}px) scale(${sx}, ${sy})`, opacity: 0 },
          { transform: 'none', opacity: 1 },
        ], 520);
        // FLIP 并行启动
        flip(others, before, 520);

        await detailAnim;
        detailEl.classList.add('ready');
        setTimeout(() => {
          others.forEach((c) => (c.style.transform = ''));
        }, reduced.matches ? 0 : 560);
      }

      async function closeDetail() {
        if (!open || !sourceCard || !detailEl) return;
        const button = sourceCard;
        const det = detailEl;
        const before = g(det);
        const backBox = { x: parseFloat(button.style.left) || 0, y: parseFloat(button.style.top) || 0, w: parseFloat(button.style.width) || 240, h: parseFloat(button.style.height) || 240 };
        // 详情缩回原位
        const sx = backBox.w / before.w, sy = backBox.h / before.h;
        det.classList.remove('ready');
        const detAnim = play(det, [
          { transform: 'none', opacity: 1 },
          { transform: `translate(${backBox.x - before.x}px, ${backBox.y - before.y}px) scale(${sx}, ${sy})`, opacity: 0 },
        ], 400);

        // 记录其余卡片当前位置（展开态），再恢复网格
        const others = cards.filter((c) => c !== button);
        const stackBefore = new Map(others.map((c) => [c, g(c)]));
        root.classList.remove('open');
        button.classList.remove('is-source');
        button.style.left = '';
        button.style.top = '';
        button.style.width = '';
        button.style.height = '';
        button.style.transform = '';

        // FLIP 回原位（与详情缩回并行）
        const after = new Map(others.map((c) => [c, g(c)]));
        others.forEach((c) => {
          const a = stackBefore.get(c)!;
          const b = after.get(c)!;
          const dx = a.x - b.x, dy = a.y - b.y, sx2 = a.w / b.w, sy2 = a.h / b.h;
          if (Math.abs(dx) < 1 && Math.abs(dy) < 1 && Math.abs(sx2 - 1) < 0.01 && Math.abs(sy2 - 1) < 0.01) return;
          void play(c, [
            { transform: `translate(${dx}px, ${dy}px) scale(${sx2}, ${sy2})`, transformOrigin: 'top left' },
            { transform: 'none' },
          ], 400);
        });

        await detAnim;
        det.hidden = true;
        det.style.opacity = '';
        root.style.minHeight = ''; // 恢复容器高度自适应
        button.setAttribute('aria-expanded', 'false');
        if (root.isConnected) button.focus({ preventScroll: true });
        setTimeout(() => others.forEach((c) => (c.style.transform = '')), reduced.matches ? 0 : 440);
        sourceCard = null;
        detailEl = null;
        open = false;
      }

      root.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('[data-close]')) { if (open) void closeDetail(); return; }
        const card = t.closest<HTMLButtonElement>('[data-album]');
        if (!card) return;
        if (!open) { void openDetail(card); }
        else if (card !== sourceCard) { void (async () => { await closeDetail(); openDetail(card); })(); }
      });
      root.addEventListener('keydown', (e) => { if (e.key === 'Escape' && open) { e.preventDefault(); void closeDetail(); } });
      document.addEventListener('astro:before-swap', () => clearAnims(), { once: true });
    });
  }
  setupArchive();
  document.addEventListener('astro:page-load', setupArchive);
</script>
