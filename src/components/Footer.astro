---
import { SITE_AUTHOR, SITE_MAINTAINER, SITE_TAGLINE } from '../consts';
const today = new Date();
---

<footer>
	<p class="tagline">{SITE_TAGLINE}</p>
	<p class="meta">
		编辑：{SITE_AUTHOR} · 站点维护：{SITE_MAINTAINER} · © {today.getFullYear()} 四时小路 Komichi
	</p>
</footer>
<style>
	footer {
		max-width: 720px;
		margin: 0 auto;
		padding: 3em 1.25em 4em;
		text-align: center;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.tagline {
		color: var(--accent);
		font-size: 0.95em;
		margin-bottom: 0.6em;
	}
	.meta {
		color: rgb(var(--gray));
		font-size: 0.82em;
	}
</style>
