---
import cinemaBackground from '../assets/videoback.jpg';
import { Image } from 'astro:assets';
import { VIDEO_CINEMA_COPY as copy, VIDEO_SUBMISSIONS, type VideoSubmission } from '../consts';

const submissions: VideoSubmission[] = VIDEO_SUBMISSIONS.length
	? VIDEO_SUBMISSIONS
	: Array.from({ length: 3 }, () => ({ title: '', image: '', url: '' }));
---

<section class="video-cinema" id="videos" aria-label={copy.label}>
	<div class="cinema-stage">
		<Image
			class="cinema-background"
			src={cinemaBackground}
			format="webp"
			widths={[640, 960, 1440, 1920, 2560, 2730]}
			sizes="100vw"
			quality="high"
			alt=""
			loading="lazy"
			decoding="async"
		/>
		<div class="cinema-screen" data-cinema tabindex="0" role="region" aria-label={copy.label}>
			<header class="cinema-heading">
				{copy.title && <h2>{copy.title}</h2>}
			</header>
			<div class="cinema-carousel">
				<button class="cinema-arrow" type="button" data-cinema-prev
					aria-label={copy.previous} disabled={submissions.length < 2}>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 5-7 7 7 7" /></svg>
				</button>
				<div class="cinema-slides">
					{submissions.map((submission, index) => (
						<div class="cinema-slide" data-cinema-slide hidden={index !== 0}>
							{submission.url ? (
								<a class="cinema-cover" href={submission.url} target="_blank" rel="noopener noreferrer"
									aria-label={submission.title || copy.label}>
									{submission.image && <img src={submission.image} alt={submission.title} loading="lazy" />}
									<span class="cinema-play" aria-hidden="true">▶</span>
								</a>
							) : (
								<div class="cinema-cover cinema-placeholder" role="img" aria-label={copy.placeholder}>
									{submission.image && <img src={submission.image} alt="" loading="lazy" />}
									<svg class="placeholder-symbol" viewBox="0 0 48 48" fill="none" aria-hidden="true">
										<rect x="5" y="9" width="38" height="30" rx="2" stroke="currentColor" stroke-width="1" />
										<path d="m21 18 10 6-10 6z" stroke="currentColor" stroke-width="1" />
									</svg>
								</div>
							)}
						</div>
					))}
				</div>
				<button class="cinema-arrow" type="button" data-cinema-next
					aria-label={copy.next} disabled={submissions.length < 2}>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 5 7 7-7 7" /></svg>
				</button>
			</div>
			<footer class="cinema-caption">
				<div class="cinema-caption-copy">
					{submissions.map((submission, index) => (
						<div data-cinema-caption hidden={index !== 0}>
							{submission.title && <h3>{submission.title}</h3>}
							{submission.description && <p>{submission.description}</p>}
						</div>
					))}
				</div>
				<span class="cinema-counter" aria-live="polite" aria-atomic="true">
					<span data-cinema-current>01</span><span aria-hidden="true"> / </span>
					<span>{String(submissions.length).padStart(2, '0')}</span>
				</span>
			</footer>
		</div>
	</div>
</section>

<style>
	.video-cinema {
		position: relative;
		min-height: 120vh;
		display: grid;
		align-items: center;
		background: #202028;
		scroll-margin-top: 0;
	}
	.cinema-stage {
		position: relative;
		width: 100%;
		container-type: inline-size;
	}
	.cinema-background { display: block; width: 100%; height: auto; }
	/* Coordinates of the blank screen in the original 2730 × 1536 image.
	   The overlay and image share one stage, so their alignment never drifts. */
	.cinema-screen {
		position: absolute;
		left: 32.3%;
		top: 16.1%;
		width: 62.2%;
		height: 55%;
		box-sizing: border-box;
		padding: 2% 2.1% 1.5%;
		display: grid;
		grid-template-rows: 10% minmax(0, 1fr) 16%;
		gap: 2%;
		color: #ded8d3;
		background: #050506;
		font-family: inherit;
	}
	.cinema-heading { min-height: 0; text-align: center; }
	.cinema-heading h2 {
		margin: 0;
		font-size: clamp(14px, 1.4cqw, 26px);
		font-weight: 500;
		letter-spacing: .12em;
	}
	.cinema-carousel {
		display: grid;
		grid-template-columns: 44px minmax(0, 1fr) 44px;
		align-items: center;
		gap: 1.2cqw;
		min-height: 0;
	}
	.cinema-slides { height: 100%; min-width: 0; min-height: 0; }
	.cinema-slide { height: 100%; display: flex; justify-content: center; align-items: center; }
	.cinema-slide[hidden], [data-cinema-caption][hidden] { display: none; }
	.cinema-cover {
		position: relative;
		display: block;
		height: 100%;
		aspect-ratio: 16 / 9;
		max-width: 100%;
		overflow: hidden;
		box-sizing: border-box;
		color: inherit;
		background: #050506;
		border: 1px solid rgb(222 216 211 / 14%);
		border-radius: 2px;
	}
	.cinema-cover img { display: block; width: 100%; height: 100%; object-fit: contain; margin: 0; }
	.cinema-placeholder {
		display: grid;
		place-items: center;
		background:
			radial-gradient(circle at 50% 48%, rgb(151 166 185 / 12%), transparent 43%),
			#050506;
	}
	.placeholder-symbol { position: absolute; width: 12%; max-width: 48px; opacity: .48; }
	.cinema-play {
		position: absolute;
		inset: 50% auto auto 50%;
		transform: translate(-50%, -50%);
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: rgb(32 32 40 / 72%);
		color: #f6ebe8;
		font-size: 16px;
	}
	.cinema-arrow {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 10px;
		border: 1px solid rgb(57 55 66 / 24%);
		border-radius: 50%;
		background: rgb(5 5 6 / 55%);
		color: #ded8d3;
		cursor: pointer;
		transition: background .2s, border-color .2s;
	}
	.cinema-arrow svg { width: 100%; height: 100%; }
	.cinema-arrow:hover:not(:disabled) { background: rgb(222 216 211 / 18%); border-color: #ded8d3; }
	.cinema-arrow:disabled { opacity: .3; cursor: default; }
	.cinema-screen:focus-visible, .cinema-arrow:focus-visible, .cinema-cover:focus-visible {
		outline: 2px solid #635961;
		outline-offset: 3px;
	}
	.cinema-caption {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 0 calc(44px + 1.2cqw);
		min-width: 0;
	}
	.cinema-caption-copy { min-width: 0; }
	.cinema-caption h3 { margin: 0; font-size: clamp(12px, 1cqw, 18px); font-weight: 500; }
	.cinema-caption p {
		margin: 3px 0 0;
		font-size: clamp(10px, .8cqw, 14px);
		color: #aaa4a4;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.cinema-counter {
		flex-shrink: 0;
		margin-left: auto;
		font-size: clamp(10px, .85cqw, 14px);
		font-variant-numeric: tabular-nums;
		letter-spacing: .12em;
		color: #aaa4a4;
	}
	@media (max-width: 820px) {
		.video-cinema { min-height: auto; scroll-margin-top: 60px; }
		.cinema-screen {
			position: absolute;
			left: 32.3%;
			top: 16.1%;
			width: 62.2%;
			height: 55%;
			padding: 1.5% 1.2%;
			grid-template-rows: 0 minmax(0, 1fr) 0;
			gap: 0;
		}
		.cinema-heading:empty { display: none; }
		.cinema-carousel { grid-template-columns: 30px minmax(0, 1fr) 30px; gap: 2px; }
		.cinema-arrow { width: 30px; height: 30px; padding: 7px; border-color: transparent; }
		.cinema-slides { height: 100%; }
		.cinema-cover { width: auto; height: 88%; }
		.cinema-caption {
			position: absolute;
			right: 3%;
			bottom: 3%;
			padding: 0;
		}
		.cinema-caption-copy { display: none; }
		.cinema-counter { font-size: clamp(7px, 1.8vw, 11px); color: #aaa4a4; }
	}
	@media (prefers-reduced-motion: reduce) {
		.cinema-arrow { transition: none; }
	}
</style>

<script>
	function initCinema() {
		document.querySelectorAll<HTMLElement>('[data-cinema]').forEach((root) => {
			if (root.dataset.cinemaReady) return;
			root.dataset.cinemaReady = 'true';
			const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-cinema-slide]'));
			const captions = Array.from(root.querySelectorAll<HTMLElement>('[data-cinema-caption]'));
			const counter = root.querySelector<HTMLElement>('[data-cinema-current]');
			if (!slides.length) return;
			let current = 0;
			const change = (direction: number) => {
				if (slides.length < 2) return;
				slides[current].getAnimations().forEach((animation) => animation.cancel());
				slides[current].hidden = true;
				captions[current].hidden = true;
				current = (current + direction + slides.length) % slides.length;
				slides[current].hidden = false;
				captions[current].hidden = false;
				if (counter) counter.textContent = String(current + 1).padStart(2, '0');
				if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					slides[current].animate([{ opacity: 0 }, { opacity: 1 }], { duration: 200 });
				}
			};
			root.querySelector('[data-cinema-prev]')?.addEventListener('click', () => change(-1));
			root.querySelector('[data-cinema-next]')?.addEventListener('click', () => change(1));
			root.addEventListener('keydown', (event) => {
				if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
				event.preventDefault();
				change(event.key === 'ArrowLeft' ? -1 : 1);
			});
		});
	}
	initCinema();
	document.addEventListener('astro:page-load', initCinema);
</script>
