---
// 明暗切换：点击在 <html data-theme> 之间切换，按钮文字「明 / 暗」（当前为暗色显示「明」，点击切到明色）
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label="切换明暗模式" title="切换明暗模式">
	<span class="icon">明</span>
</button>

<style>
	.theme-toggle {
		border: none;
		background: none;
		cursor: pointer;
		color: #e6e2d8;
		font-size: 0.95em;
		letter-spacing: 0.1em;
		padding: 0.4em 0.8em;
		transition: color 0.2s ease;
	}
	.theme-toggle:hover {
		color: #ff2231;
	}
</style>

<script>
	const btn = document.getElementById('theme-toggle');
	const icon = btn?.querySelector('.icon');

	function current() {
		return document.documentElement.getAttribute('data-theme') || 'dark';
	}

	function syncIcon(theme) {
		if (icon) icon.textContent = theme === 'dark' ? '明' : '暗';
	}

	function setTheme(theme) {
		document.documentElement.setAttribute('data-theme', theme);
		try {
			localStorage.setItem('theme', theme);
		} catch (e) {
			/* 隐私模式等场景忽略 */
		}
		syncIcon(theme);
	}

	if (btn) {
		syncIcon(current());
		btn.addEventListener('click', () => setTheme(current() === 'dark' ? 'light' : 'dark'));
	}

	// ClientRouter 页面切换后脚本会重新执行，确保按钮文字与当前主题一致
	document.addEventListener('astro:page-load', () => syncIcon(current()));
</script>
